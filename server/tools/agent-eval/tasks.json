{
  "about": "Stage 3 acceptance: multi-step instructions across the apps people use, plus six in apps that were not tested when the rules were written (Excel, a PDF, a file from Explorer, the Save dialog, Spotify, the Start menu). Each check is read from the screen after the task (tools/agent-eval/run.mjs) and is strict: a control's type and an exact phrase that is only on the page the task should reach. 'apps' are the processes the runner closes afterwards, but only if they were not already open. 'fixtures' are made in Documents before each live run.",
  "fixtures": {
    "create": [
      { "name": "ablespeak-eval.txt", "text": "AbleSpeak evaluation file. Do not edit.\r\n" },
      { "name": "ablespeak-eval.pdf", "text": "AbleSpeak evaluation file" }
    ],
    "remove": ["eval-saved.txt"]
  },
  "tasks": [
    {
      "id": "notepad-type",
      "instruction": "Open Notepad and type My name is Amina",
      "apps": ["notepad"],
      "checks": [{ "kind": "text", "app": "notepad", "includes": ["My name is Amina"] }]
    },
    {
      "id": "notepad-two-lines",
      "instruction": "Open Notepad, type Line one, then start a new line and type Line two",
      "apps": ["notepad"],
      "checks": [{ "kind": "text", "app": "notepad", "includes": ["Line one", "Line two"] }]
    },
    {
      "id": "notepad-replace",
      "instruction": "Open Notepad, type cat, then select all and type dog",
      "apps": ["notepad"],
      "checks": [{ "kind": "text", "app": "notepad", "includes": ["dog"], "excludes": ["cat"] }]
    },
    {
