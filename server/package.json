{
  "name": "ablespeak-gateway",
  "version": "1.0.0",
  "description": "AbleSpeak — Accessible voice command center for hands-free computing",
  "main": "electron-main.cjs",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test",
    "desktop": "node launch-electron.cjs",
    "voice-model": "node tools/fetch-voice-model.mjs",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.ablespeak.desktop",
    "productName": "AbleSpeak",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "src/**/*",
      "electron-main.cjs",
      "overlay.html",
      "overlay-messages.js",
      "overlay-preload.cjs",
      "overlay-wake.cjs",
      "wake-preload.cjs",
      "tts-host.cjs",
      "NOTICE.md",
      "tools/**/*",
      "node_modules/**/*",
      "!**/*.test.mjs",
      "!tools/grounding-eval/images/**",
      "!tools/grounding-eval/out/**",
      "!tools/grounding-eval/dataset.json",
      "!tools/live-chrome.mjs",
      "!tools/live-chrome-run/**",
      "!tools/fetch-voice-model.mjs"
    ],
    "extraResources": [
      {
        "from": "../dashboard/dist",
        "to": "dashboard/dist"
      },
      {
        "from": "../chrome-integration-master",
        "to": "chrome-extension"
      },
      {
        "from": "vendor/voice-lock",
        "to": "voice-lock"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "src/voiceprint-worker.cjs",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-win-x64/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../dashboard/public/ablespeak-logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AbleSpeak",
      "uninstallDisplayName": "AbleSpeak Voice Assistant"
    }
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "cors": "^2.8.5",
    "docx": "^9.10.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.4.299",
    "sherpa-onnx-node": "1.13.8",
    "sql.js": "^1.11.0",
    "uuid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "playwright-core": "^1.64.1"
  }
}
